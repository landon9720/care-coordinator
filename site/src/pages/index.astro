---
import providersData from '../data/providers.json';
import agentsData from '../data/agents.json';
import '../styles/global.css';

const providers = providersData.providers;
const agents = agentsData.agents;

const repo = 'https://github.com/landon9720/care-coordinator';
const title = 'Care Coordinator — take control of your health journey';
const description =
  'The technology to coordinate your own medical care is finally here. A free guide to getting your records out of your health system, organizing them on your own computer, and using an AI assistant to track what is open and write what needs writing.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- WORKING DRAFT. Remove this line to allow search engines to index
         the site. Nothing else needs to change. -->
    <meta name="robots" content="noindex" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="https://care.landon9720.com/" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>🩺</text></svg>"
    />
  </head>
  <body class="guide">
    <main class="wrap">
      <header class="masthead">
        <h1>The technology is finally here.</h1>
        <p class="lede">
          Large hospital systems employ <strong>care coordinators</strong> —
          people whose whole job is keeping track of what was ordered, what came
          back, what is still waiting, and what to raise next time. Almost nobody
          gets assigned one. For most people that job has always fallen to them,
          between appointments, from memory, with no tools.
        </p>
        <p class="lede">
          <strong>That role can be filled now.</strong> AI assistants recently got
          good enough to read an entire medical history, keep track of what is
          open, and write what needs writing. Not in a few years — today, on your
          own computer, for the cost of a subscription.
        </p>
        <p class="lede">
          This is a free guide to doing exactly that: getting your records,
          putting them somewhere they are genuinely yours, and finally having
          something that keeps track. It works the same whether you are doing it
          for yourself or for someone you are looking after.
        </p>
        <p class="resolve">
          You can take control of your health journey. Not metaphorically —
          the records, the history, the follow-ups, the correspondence. All of it,
          in your hands.
        </p>
      </header>

      <section class="does" aria-labelledby="does-heading">
        <h2 id="does-heading">What you get</h2>
        <p>
          Your whole medical history, on your own computer, in a form you and an
          assistant can both read. Then you can just ask for things.
        </p>

        <div class="grid">
          <div class="cap">
            <h3>Get your records</h3>
            <p>
              Every visit, test result, medication, immunization and procedure
              your health systems have on file — downloaded and turned into
              plain readable text instead of the machine format they arrive in.
            </p>
          </div>
          <div class="cap">
            <h3>Add what isn't in the chart</h3>
            <p>
              Tell it what you remember and it writes it down: symptoms between
              visits, what a doctor actually said, what you tried, things that
              happened before any of this was computerized. Most of your history
              is not in your record.
            </p>
          </div>
          <div class="cap">
            <h3>Get things written for you</h3>
            <p>
              Messages to your clinic. Requests for records from an old doctor.
              A page to bring to your appointment with what has happened and what
              to ask. A summary for a new specialist. Corrections when the record
              is wrong.
            </p>
          </div>
          <div class="cap">
            <h3>Stop losing track</h3>
            <p>
              It knows what was started and never finished, and how long it has
              been sitting. The scan you never booked. The referral that went
              nowhere. The message nobody answered.
            </p>
          </div>
        </div>

        <p class="asks">Once it is set up, this is what using it looks like:</p>
        <ul class="examples">
          <li>“What am I waiting on right now?”</li>
          <li>“Did I ever get that scan they ordered?”</li>
          <li>“Write to my clinic and ask where my referral went.”</li>
          <li>“I have an appointment Thursday. What should I bring up?”</li>
          <li>“Put together a summary of my history for a new specialist.”</li>
          <li>“Get my records from the clinic I used to go to.”</li>
        </ul>
      </section>

      <section class="honest" aria-labelledby="honest-heading">
        <h2 id="honest-heading">Two things take real effort</h2>
        <p>
          Both are surmountable, and both are one-time. We would rather name them
          now than have you think you did something wrong when you meet them.
        </p>

        <div class="hard">
          <h3>Getting an AI assistant set up</h3>
          <p>
            You will download a program, create an account, and enter a payment
            method. <strong>It costs money.</strong> There is no free option that
            does this part well. If you have never installed something like this,
            the first half hour feels unfamiliar.
          </p>
          <p class="fix">
            That is the whole difficulty, and it is a one-time cost. There is no
            programming. You will not see a black screen with green text. After
            setup, you type ordinary sentences.
          </p>
        </div>

        <div class="hard">
          <h3>Getting your records out</h3>
          <p>
            Every health system buries this somewhere different, calls it
            something different, and makes you wait for it. Some staff do not know
            the feature exists. You may have to ask more than once.
          </p>
          <p class="fix">
            You have a legal right to these records, and that matters more than it
            sounds — it turns the conversation from a favor you are asking into a
            request they are required to fulfill. We will show you the words.
          </p>
        </div>

        <p class="resolve">
          Neither requires a skill you do not have, and neither takes more than
          an afternoon. After that, the ongoing part is just asking questions in
          plain language. People who find this page are usually dealing with
          something real, for themselves or someone they love — that motivation is
          more than enough to get through an afternoon of setup.
        </p>
      </section>

      <section class="picker" aria-labelledby="picker-heading">
        <h2 id="picker-heading">Let's find your situation</h2>
        <p>
          Answer two questions and we will show you what we know. We are honest
          about the gaps. This is a young project, and for most combinations
          nobody has written the details down yet.
        </p>

        <div class="field">
          <label for="provider">
            <span class="step">1</span>
            Where do you see your doctor?
          </label>
          <p class="hint">
            Not sure? Think about the website you use to check test results or
            send your doctor a message. What is it called?
          </p>
          <select id="provider">
            <option value="">— Please choose —</option>
            {providers.map((p) => (
              <option value={p.id}>
                {p.name}{p.vendor ? ` (${p.vendor})` : ''}
              </option>
            ))}
          </select>
        </div>

        <div class="field">
          <label for="agent">
            <span class="step">2</span>
            Which AI assistant do you have?
          </label>
          <p class="hint">
            There is no wrong answer. "I don't have one yet" is the most common
            one, and it is fine.
          </p>
          <select id="agent">
            <option value="">— Please choose —</option>
            {agents.map((a) => (
              <option value={a.id}>
                {a.name}{a.recommended ? ' — recommended' : ''}
              </option>
            ))}
          </select>
        </div>
      </section>

      <section id="results" aria-live="polite"></section>

      <footer>
        <p>
          <a href={repo}>This project is open source.</a> Anything missing above
          can be filled in by anyone, and corrections are welcome. There is a
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>guide to contributing</a>.
        </p>
        <p>
          <a href="/technical">Technical documentation</a> — for people who are
          comfortable with a command line.
        </p>
        <p class="fineprint">
          Not affiliated with any hospital, health system, or software company.
        </p>
      </footer>
    </main>

    <script is:inline define:vars={{ providers, agents, repo }}>
      const $ = (id) => document.getElementById(id);
      const results = $('results');
      const esc = (s) =>
        String(s).replace(
          /[&<>"]/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]
        );
      const ol = (items) =>
        `<ol>${items.map((s) => `<li>${esc(s)}</li>`).join('')}</ol>`;
      const rec = agents.find((x) => x.recommended);

      function providerBlock(p) {
        if (!p) return '';
        if (p.status === 'verified' && p.steps.length) {
          return `
            <div class="card">
              <h3><span class="num">1</span> Get your records from ${esc(p.name)}</h3>
              <p class="verified">Somebody has done this and written down the steps.</p>
              ${ol(p.steps)}
              ${p.format ? `<p class="meta">What you get: ${esc(p.format)}. It will look like nonsense if you open it. That is expected — making it readable is the assistant's job.</p>` : ''}
              ${p.warnings.map((w) => `<p class="warn">${esc(w)}</p>`).join('')}
            </div>`;
        }
        return `
          <div class="card">
            <h3><span class="num">1</span> Get your records${p.id !== 'other' ? ` from ${esc(p.name)}` : ''}</h3>
            <p class="unknown">We don't have step-by-step instructions for this one yet.</p>
            <p>Here is the general approach, which works almost everywhere:</p>
            <ol>
              <li>Sign in to the website you use to check test results or message your doctor.</li>
              <li>Look through the menu for anything called <em>Records</em>, <em>Documents</em>, <em>Health Record</em>, <em>Download</em>, or <em>Share my record</em>. It is usually not on the front page.</li>
              <li>Ask for your <strong>complete</strong> record, or <strong>all visits</strong> — not a single appointment.</li>
              <li>It may take minutes or hours to prepare. Come back later and download the file.</li>
              <li>Save it somewhere you will find it again, and don't delete it. Download links usually expire after a week or so.</li>
            </ol>
            ${p.warnings.map((w) => `<p class="warn">${esc(w)}</p>`).join('')}
            <p class="ask">Once you work it out, <a href="${repo}/issues/new">please tell us how you did it</a> so the next person has real instructions. Describe the buttons you clicked. Never anything about your health.</p>
          </div>`;
      }

      function rightsBlock(p) {
        if (!p) return '';
        return `
          <div class="card rights-card">
            <h3>If they give you trouble</h3>
            <p>This happens, and it is not a sign you did anything wrong. Staff at the front desk often do not know this feature exists.</p>
            <p>In the United States you have a <strong>legal right</strong> to a copy of your records, and they have <strong>30 days</strong> to give it to you. The law is HIPAA. A second law, the 21st Century Cures Act, says they may not block your electronic access. <strong>You do not have to explain why you want them.</strong></p>
            <p>If you need to say it out loud, or write it in a message through the portal, this is enough:</p>
            <div class="prompt">
              <p id="rightsText">I am making a request under my HIPAA right of access. I would like a complete electronic copy of my medical record. I understand this must be provided within 30 days.</p>
              <button type="button" id="copyRights">Copy this</button>
            </div>
            <p class="note">Ask for it in writing through the portal if you can. It creates a dated record of when you asked, which is exactly the kind of thing that otherwise gets forgotten.</p>
          </div>`;
      }

      function agentBlock(a) {
        if (!a) return '';
        if (a.id === 'none') {
          return `
            <div class="card">
              <h3><span class="num">2</span> Get an AI assistant</h3>
              <p>We suggest <strong>${esc(rec.name)}</strong>.</p>
              <p>${esc(rec.summary)}</p>
              <p class="meta">${esc(rec.cost)}</p>
              ${ol(rec.setup)}
              ${rec.notes.map((n) => `<p class="note">${esc(n)}</p>`).join('')}
            </div>`;
        }
        return `
          <div class="card">
            <h3><span class="num">2</span> Set up ${esc(a.name)}</h3>
            ${
              a.status === 'verified'
                ? `<p class="verified">This one has been used for the whole process, start to finish.</p>`
                : `<p class="unknown">Nobody has reported using this one all the way through. The general approach still applies.</p>`
            }
            <p>${esc(a.summary)}</p>
            ${a.cost ? `<p class="meta">${esc(a.cost)}</p>` : ''}
            ${a.setup.length ? ol(a.setup) : ''}
            ${a.notes.map((n) => `<p class="note">${esc(n)}</p>`).join('')}
            ${
              !a.recommended
                ? `<p class="note">If this turns out to be frustrating, <strong>${esc(rec.name)}</strong> is the one that can handle a whole folder of records at once instead of one file at a time.</p>`
                : ''
            }
          </div>`;
      }

      function goBlock(a) {
        const t = a && a.firstMessage ? a : rec;
        if (!t || !t.firstMessage) return '';
        const swap = t.id !== (a && a.id);
        return `
          <div class="card go">
            <h3><span class="num">3</span> Now just ask</h3>
            ${swap ? `<p class="note">This step assumes ${esc(t.name)}, from step 2.</p>` : ''}
            <p>Open ${esc(t.name)} and type this. You can copy it.</p>
            <div class="prompt">
              <p id="promptText">${esc(t.firstMessage)}</p>
              <button type="button" id="copyBtn">Copy this</button>
            </div>
            <p>That is genuinely it. It will fetch what it needs, ask your permission before touching anything on your computer, and walk you through the rest in plain language.</p>
            <p>From there you talk to it normally. Ask it to open your records and tell you what it found. Ask what you are waiting on. Ask it to write to your clinic, or to put together what you should raise at your next appointment. Tell it things it should know that your chart does not.</p>
            <p class="note">It drafts; you send. Nothing goes to a doctor, a clinic, or a portal without you reading it first.</p>
          </div>`;
      }

      function render() {
        const p = providers.find((x) => x.id === $('provider').value);
        const a = agents.find((x) => x.id === $('agent').value);
        if (!p && !a) {
          results.innerHTML = '';
          return;
        }
        results.innerHTML = `
          <h2>Your steps</h2>
          ${providerBlock(p)}
          ${rightsBlock(p)}
          ${agentBlock(a)}
          ${p && a ? goBlock(a) : '<p class="more">Answer both questions above to see the last step.</p>'}
        `;
        wireCopy('copyBtn', 'promptText');
        wireCopy('copyRights', 'rightsText');
      }

      function wireCopy(btnId, textId) {
        const btn = $(btnId);
        const src = $(textId);
        if (!btn || !src) return;
        btn.addEventListener('click', () => {
          navigator.clipboard
            .writeText(src.textContent.trim())
            .then(() => {
              btn.textContent = 'Copied';
              setTimeout(() => (btn.textContent = 'Copy this'), 2000);
            })
            .catch(() => {
              btn.textContent = 'Select it and copy';
            });
        });
      }

      $('provider').addEventListener('change', render);
      $('agent').addEventListener('change', render);
    </script>
  </body>
</html>
